{
  "name": "toddlebook",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" vite.config.ts index.html package.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node --experimental-strip-types scripts/migrate.mjs",
    "reset-password": "node --experimental-strip-types scripts/reset-password.mjs",
    "parity:capture": "node scripts/parity/capture.mjs",
    "parity:verify": "node scripts/parity/verify.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.169.7",
    "@tanstack/react-start": "^1.169.7",
    "@vitejs/plugin-react": "^5.0.0",
    "better-auth": "1.7.28",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^0.468.0",
    "nitro": "^3.0.261103-rc",
    "nodemailer": "10.6.1",
    "pg": "8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "1.65.1",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "^5.7.2",
    "vitest": "^5.1.2"
  }
}
